// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique // MUST be college email
  passwordHash String
  role         Role       @default(STUDENT)
  isApproved   Boolean    @default(false)
  reputation   Int        @default(0)
  branch       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  questions    Question[]
  answers      Answer[]
}

model Question {
  id        String   @id @default(uuid())
  title     String
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hasPoll   Boolean  @default(false)

  answers   Answer[]
  tags      Tag[]    @relation("QuestionTags")
  poll      Poll?
}

model Poll {
  id         String   @id @default(uuid())
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  options    String[] // Array of strings for options
  votes      Json     // Store votes as JSON
}

model Answer {
  id                String   @id @default(uuid())
  body              String
  questionId        String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId          String
  author            User     @relation(fields: [authorId], references: [id])
  isFacultyVerified Boolean  @default(false)
  upvotes           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  questions Question[] @relation("QuestionTags")
}
